{
  "name": "flower-studio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "catalog:import": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/import-catalog.ps1",
    "catalog:preview": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/import-catalog.ps1 -Preview",
    "test:catalog": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/import-catalog.ps1 -Test"
  },
  "dependencies": {
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
